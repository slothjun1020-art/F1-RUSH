{
  "name": "f1-race",
  "version": "1.0.0",
  "description": "Real-time online F1-style top-down racing game for friends",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "e2e": "node scripts/e2e.mjs",
    "e2e:leave": "node scripts/e2e-leave.mjs",
    "e2e:fallback": "node scripts/e2e-fallback.mjs",
    "e2e:features": "node scripts/e2e-features.mjs",
